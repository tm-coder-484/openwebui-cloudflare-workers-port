{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts"],
	// Tests run under Node (vitest transpiles them); the worker tsconfig only
	// loads the Workers runtime types, so they are checked by vitest, not tsc.
	"exclude": ["test", "scripts", "node_modules"]
}
