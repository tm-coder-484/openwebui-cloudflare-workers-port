{
	"name": "open-webui-workers",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Workers port of the Open WebUI backend",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoke": "node scripts/smoke.mjs",
		"mock": "node scripts/mock-openai.mjs",
		"mock:oidc": "node scripts/mock-oidc.mjs",
		"mock:search": "node scripts/mock-search.mjs",
		"db:local": "wrangler d1 migrations apply open-webui --local",
		"db:remote": "wrangler d1 migrations apply open-webui --remote"
	},
	"dependencies": {
		"hono": "^4.6.14"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260903.1",
		"typescript": "^5.5.4",
		"vitest": "^1.6.1",
		"wrangler": "^4.128.0"
	}
}
