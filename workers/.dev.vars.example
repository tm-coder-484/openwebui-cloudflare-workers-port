# Copy to workers/.dev.vars for local development (`wrangler dev` loads it automatically).
# Never commit the real file — it holds secrets.

# Signs session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBUI_SECRET_KEY=change-me

# Primary provider: NVIDIA NIM. Get a key at https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...
# Self-hosted NIM microservice instead of the hosted catalogue:
# NVIDIA_API_BASE_URL=https://nim.internal.example/v1

# Any other OpenAI-compatible endpoint. Comma-separate to configure several.
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Local mock model server (`node workers/scripts/mock-openai.mjs`):
# OPENAI_API_BASE_URL=http://127.0.0.1:11435/v1
# OPENAI_API_KEY=mock-key

# ── OAuth / OIDC sign-in ──────────────────────────────────────────────────
# The generic OIDC client is also editable in Admin Settings → Authentication;
# anything set here is the default until an admin saves that screen.
# OAUTH_CLIENT_ID=open-webui
# OAUTH_CLIENT_SECRET=...
# OPENID_PROVIDER_URL=https://idp.example.com/.well-known/openid-configuration

# Local mock identity provider (`node workers/scripts/mock-oidc.mjs`):
# OAUTH_CLIENT_ID=open-webui
# OAUTH_CLIENT_SECRET=open-webui-secret
# OPENID_PROVIDER_URL=http://127.0.0.1:9500/.well-known/openid-configuration

# The named providers are env-only, matching upstream.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CLIENT_TENANT_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Ollama Cloud ──────────────────────────────────────────────────────────
# ollama.com speaks the OpenAI API at /v1. Several keys can be pooled: one is
# picked per request and the others are tried if it is rate-limited.
# OLLAMA_API_KEYS=key-one,key-two,key-three
# OLLAMA_BASE_URL=https://ollama.com/v1

# Tools the model may call, and how many rounds of them one turn allows.
# TOOLS_MAX_ROUNDS=3
# ENABLE_MEMORY_TOOLS=true
# ENABLE_FILE_TOOLS=true
# ENABLE_SEARCH_TOOLS=true
# ENABLE_TODO_TOOLS=true
# ENABLE_KNOWLEDGE_TOOLS=true
